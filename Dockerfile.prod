# Production Dockerfile for Lernplaner
# Multi-stage build for optimized production image

# Stage 1: Build the Next.js application
FROM node:18-alpine AS builder

WORKDIR /app

# Set NODE_ENV to production for build (ensures assetPrefix is applied)
ENV NODE_ENV=production

# Accept build args for client-side env vars
ARG NEXT_PUBLIC_NEXTAUTH_URL
ENV NEXT_PUBLIC_NEXTAUTH_URL=$NEXT_PUBLIC_NEXTAUTH_URL

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build the Next.js application
RUN npm run build

# Stage 2: Run the Next.js application
FROM node:18-alpine

WORKDIR /app

ENV NODE_ENV=production

# Copy package files
COPY package.json package-lock.json ./

# Install production dependencies only
RUN npm ci --only=production

# Copy built application from builder stage
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/next.config.js ./next.config.js
COPY --from=builder /app/src ./src
COPY --from=builder /app/db ./db

# Create public directory (lernplaner doesn't have static assets in public folder)
RUN mkdir -p public

# Create uploads directory (if needed by the app)
RUN mkdir -p uploads

# Expose port 3000
EXPOSE 3000

# Start the application
CMD ["npm", "start"]

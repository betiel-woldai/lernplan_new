{
  "watchers": [
    {
      "name": "components",
      "patterns": ["src/components/**/*.{ts,tsx}", "src/hooks/**/*.{ts,tsx}"],
      "command": "npm run type-check"
    },
    {
      "name": "tests",
      "patterns": ["tests/**/*.spec.ts"],
      "command": "npx playwright test {file}"
    },
    {
      "name": "api",
      "patterns": ["src/pages/api/**/*.ts"],
      "command": "npm run type-check"
    }
  ]
}
# ============================================
# Lernplaner - Environment Configuration
# ============================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual configuration
# 3. NEVER commit the .env file to git (it's in .gitignore)
# 4. Keep this .env.example file updated when adding new variables
#
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL database connection settings
# Generate secure passwords with: openssl rand -base64 32

# Database host (use 'localhost' for local development)
DATABASE_HOST=localhost

# Database port (default PostgreSQL port is 5432)
DATABASE_PORT=5432

# Database name
DATABASE_NAME=lernplaner_data

# Database user
DATABASE_USER=lernplaner_user

# Database password (must be strong and unique!)
DATABASE_PASSWORD=your_secure_database_password_here

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================
# NextAuth.js is used for authentication and session management

# NextAuth URL - The base URL of your application
# Local development: http://localhost:3000
# Production: https://your-domain.com/lernplaner
NEXTAUTH_URL=http://localhost:3000

# Public NextAuth URL (exposed to frontend)
# Should match NEXTAUTH_URL for most cases
NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret - Used to encrypt JWT tokens and session data
# CRITICAL: Must be unique and kept secret!
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl

# ============================================
# KEYCLOAK AUTHENTICATION
# ============================================
# Keycloak is used for OAuth/OIDC authentication
# You must set up your own Keycloak instance
# Documentation: https://www.keycloak.org/getting-started

# Keycloak Client ID
# Create a client in your Keycloak realm and use that client ID
KEYCLOAK_CLIENT_ID=lernplaner-client

# Keycloak Client Secret
# Get this from your Keycloak client configuration
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here

# Keycloak Issuer URL
# Format: https://your-keycloak-domain.com/keycloak/realms/your-realm-name
# Example: https://auth.example.com/keycloak/realms/dias
KEYCLOAK_ISSUER=https://your-domain.com/keycloak/realms/dias

# ============================================
# OPTIONAL: DEVELOPMENT SETTINGS
# ============================================
# These settings are optional and typically used for local development only

# Default User ID for Development
# Uncomment these lines if you want to bypass authentication in development
# WARNING: Never use in production!
# NEXT_PUBLIC_DEFAULT_USER_ID=demo-user-123
# DEFAULT_USER_ID=demo-user-123

# ============================================
# QUICK START FOR LOCAL DEVELOPMENT
# ============================================
#
# 1. Install PostgreSQL or use Docker:
#    docker run --name lernplaner-db -e POSTGRES_PASSWORD=yourpassword \
#    -e POSTGRES_DB=lernplaner_data -e POSTGRES_USER=lernplaner_user \
#    -p 5432:5432 -d postgres:15
#
# 2. Update database settings above with your PostgreSQL credentials
#
# 3. Generate NEXTAUTH_SECRET:
#    openssl rand -base64 32
#
# 4. Set up Keycloak (see docs/keycloak-setup.md or setup/README.md)
#
# 5. Update KEYCLOAK_* variables with your Keycloak configuration
#
# 6. Copy this file: cp .env.example .env
#
# 7. Edit .env with your actual values
#
# 8. Install dependencies: npm install
#
# 9. Run database migrations (if applicable):
#    npm run migrate
#
# 10. Start the development server:
#     npm run dev
#
# 11. Open http://localhost:3000 in your browser
#
# ============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================
#
# [ ] All passwords are strong and unique (use password manager)
# [ ] NEXTAUTH_SECRET is generated and unique (use openssl rand -base64 32)
# [ ] Database is properly secured (not using default passwords)
# [ ] Keycloak is properly configured with HTTPS
# [ ] All URLs point to production domains (no localhost)
# [ ] Database backups are configured
# [ ] SSL/TLS certificates are configured
# [ ] Environment variables are stored securely (not in code)
# [ ] Default development user is DISABLED (comment out DEFAULT_USER_ID)
# [ ] Application is running behind a reverse proxy (nginx/apache)
# [ ] Rate limiting is configured
# [ ] Monitoring and logging are set up
# [ ] Security headers are configured
#
# ============================================
# ADDITIONAL RESOURCES
# ============================================
#
# - Lernplaner Documentation: See README.md
# - Keycloak Setup Guide: See setup/README.md or docs/
# - NextAuth.js Documentation: https://next-auth.js.org/
# - PostgreSQL Documentation: https://www.postgresql.org/docs/
#
# ============================================

# Environment Variables Template for Lernplaner
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_HOST=your_database_host
DATABASE_PORT=5432
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password

# NextAuth Configuration
NEXTAUTH_URL=https://your-domain.com/dias_test/lernplaner
NEXT_PUBLIC_NEXTAUTH_URL=https://your-domain.com/dias_test/lernplaner
NEXTAUTH_SECRET=your_nextauth_secret_here

# Keycloak Configuration (shared with DIAS)
KEYCLOAK_CLIENT_ID=your_keycloak_client_id
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
KEYCLOAK_ISSUER=https://your-domain.com/keycloak/realms/your_realm

# Optional: Default User for Local Development Only
# NEXT_PUBLIC_DEFAULT_USER_ID=demo-user-123
# DEFAULT_USER_ID=demo-user-123

# ============================================
# Lernplaner - Git Ignore Rules
# ============================================
# This file specifies intentionally untracked files that Git should ignore
# IMPORTANT: Never commit secrets, credentials, or sensitive data!

# ============================================
# DEPENDENCIES
# ============================================
/node_modules
/.pnp
.pnp.js

# ============================================
# NEXT.JS BUILD OUTPUT
# ============================================
/.next/
/out/
/build
dist/

# ============================================
# ENVIRONMENT VARIABLES & SECRETS
# ============================================
# CRITICAL: Never commit these files!
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
!.env.example

# Secrets and credentials
secrets/
credentials/
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
config/secrets.json
.secrets

# ============================================
# LOGS
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# DATABASES
# ============================================
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
postgres-data/
mysql-data/

# ============================================
# TESTING & COVERAGE
# ============================================
/coverage
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ============================================
# TYPESCRIPT
# ============================================
*.tsbuildinfo
next-env.d.ts

# ============================================
# IDE & EDITORS
# ============================================
# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains IDEs (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================
# OPERATING SYSTEM FILES
# ============================================
# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ============================================
# DEPLOYMENT & HOSTING
# ============================================
.vercel
.netlify

# ============================================
# DOCKER
# ============================================
docker-compose.override.yml

# ============================================
# UPLOADS & USER CONTENT
# ============================================
/uploads/*
!/uploads/.gitkeep

# ============================================
# TEMPORARY FILES
# ============================================
tmp/
temp/
*.tmp
*.bak
*.backup
*.old

# ============================================
# MISC
# ============================================
.eslintcache
.stylelintcache

# Package manager lock files (uncomment if needed)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
